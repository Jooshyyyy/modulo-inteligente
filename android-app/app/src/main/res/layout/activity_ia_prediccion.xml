<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_light"
    tools:openDrawer="start">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bank_primary"
            app:navigationIcon="@drawable/ic_menu"
            app:title="Coach IA y Predicciones"
            app:titleTextColor="@color/text_on_primary" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- PASO 1 (VISUAL): EL COACH IA (Antes Paso 2, ahora principal) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardIaCoach"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_gradient_card"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.05"
                            android:text="Análisis del Coach de ahorro (IA)"
                            android:textAllCaps="true"
                            android:textColor="#E0F2FE"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingEnd="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Gasto proyectado del mes"
                                    android:textColor="#C0E0F8"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvCoachKpiGasto"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="—"
                                    android:textColor="@color/white"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Días con predicción"
                                    android:textColor="#C0E0F8"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvCoachKpiDias"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="—"
                                    android:textColor="@color/white"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCoachSemaforo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_badge_light"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Riesgo: —"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Burbuja de cita estilizada con borde izquierdo para el Coach IA -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_quote_card"
                            android:padding="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCoachNarrativa"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="4dp"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="italic" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvCoachIndicadores"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:overScrollMode="never"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/item_ia_coach_indicator" />

                        <ProgressBar
                            android:id="@+id/pbMetaProgreso"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="14dp"
                            android:max="100"
                            android:progressTint="@color/bank_accent"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvMetaResumen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="Recortes para volver a tu presupuesto"
                            android:textColor="@color/text_muted"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvCoachSugerencias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:overScrollMode="never"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/item_ia_coach_suggestion" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- PASO 2 (VISUAL): CONFIGURACIÓN DE PRESUPUESTO (Colapsable y Simplificado) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/card_surface"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Encabezado táctil para colapsar/expandir -->
                        <LinearLayout
                            android:id="@+id/layoutMetaHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Presupuesto y Límites"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvToggleMetaIndicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Configurar ▾"
                                android:textColor="@color/bank_accent"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Contenido que se colapsa -->
                        <LinearLayout
                            android:id="@+id/layoutMetaContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Establece un tope mensual general o límites para categorías clave que cruzar con las predicciones."
                                android:textColor="@color/text_muted"
                                android:textSize="15sp" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipGroupTipoPlan"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                app:singleLine="false"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipPresupuestoGeneral"
                                    style="@style/Widget.MaterialComponents.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:chipBackgroundColor="@color/chip_bg"
                                    android:textColor="@color/text_primary"
                                    android:text="Tope mensual general" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipPresupuestoCategorias"
                                    style="@style/Widget.MaterialComponents.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:chipBackgroundColor="@color/chip_bg"
                                    android:textColor="@color/text_primary"
                                    android:text="Límites por categoría" />
                            </com.google.android.material.chip.ChipGroup>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilMetaTitulo"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                app:boxStrokeColor="@color/bank_accent"
                                android:textColorHint="@color/text_muted"
                                android:hint="Nombre del plan (opcional)">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etMetaTitulo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_primary"
                                    android:inputType="textCapSentences" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilMetaMonto"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:boxStrokeColor="@color/bank_accent"
                                android:textColorHint="@color/text_muted"
                                android:hint="Tope de gasto mensual (Bs.)">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etMetaMonto"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_primary"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:id="@+id/tvHintCategorias"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Marcá categorías y poné un tope en Bs. para cada una."
                                android:textColor="@color/text_muted"
                                android:textSize="15sp"
                                android:visibility="gone" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvLimitesCategoria"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:nestedScrollingEnabled="false"
                                android:visibility="gone" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:gravity="end"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPausarMeta"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_primary"
                                    android:text="Quitar plan"
                                    android:visibility="gone" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnGuardarMeta"
                                    android:layout_width="wrap_content"
                                    android:layout_height="52dp"
                                    app:backgroundTint="@color/bank_primary"
                                    android:textColor="@color/text_on_primary"
                                    android:text="Activar presupuesto" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- PASO 3: EXPLORADOR DEL MES E INTERACTIVIDAD GRÁFICA -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    app:cardBackgroundColor="@color/card_surface_alt"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnPrevMonth"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="◀"
                                android:textColor="@color/bank_accent" />

                            <TextView
                                android:id="@+id/tvMonthTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="Mes"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnNextMonth"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▶"
                                android:textColor="@color/bank_accent" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Paso 3 · Explorá tu mes"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMonthTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Bs. 0.00"
                            android:textColor="@color/text_primary"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMonthSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Suma de lo que el modelo espera gastar en el mes. Comparalo con tu tope o límites por categoría."
                            android:textColor="@color/text_muted"
                            android:textSize="15sp" />

                        <!-- Selector dinámico de gráficos (Tabs) -->
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupGraficos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:singleSelection="true"
                            app:checkedChip="@+id/chipGraficoPie">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipGraficoPie"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Distribución" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipGraficoRadar"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Radar" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipGraficoLinea"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tendencia diaria" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipGraficoBarras"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Semanas" />
                        </com.google.android.material.chip.ChipGroup>

                        <!-- Contenedor único para los gráficos stackeados -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="250dp"
                            android:layout_marginTop="16dp">

                            <com.github.mikephil.charting.charts.PieChart
                                android:id="@+id/pieChartCategorias"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <com.github.mikephil.charting.charts.RadarChart
                                android:id="@+id/radarChartCategorias"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone" />

                            <com.github.mikephil.charting.charts.LineChart
                                android:id="@+id/lineChartDias"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone" />

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/barChartSemanas"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="Categorías (tocá para filtrar días)"
                            android:textColor="@color/text_muted"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvMonthlyCategoryList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:overScrollMode="never"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/item_weekly_category" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="Días del mes"
                            android:textColor="@color/text_muted"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:scrollbars="none">
                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipGroupSemanas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:singleLine="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipSemana1"
                                    style="@style/Widget.MaterialComponents.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:chipBackgroundColor="@color/bg_light"
                                    android:textColor="@color/text_primary"
                                    android:text="Semana 1" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipSemana2"
                                    style="@style/Widget.MaterialComponents.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:chipBackgroundColor="@color/bg_light"
                                    android:textColor="@color/text_primary"
                                    android:text="Semana 2" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipSemana3"
                                    style="@style/Widget.MaterialComponents.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:chipBackgroundColor="@color/bg_light"
                                    android:textColor="@color/text_primary"
                                    android:text="Semana 3" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipSemana4"
                                    style="@style/Widget.MaterialComponents.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:chipBackgroundColor="@color/bg_light"
                                    android:textColor="@color/text_primary"
                                    android:text="Semana 4+" />
                            </com.google.android.material.chip.ChipGroup>
                        </HorizontalScrollView>

                        <TextView
                            android:id="@+id/tvSelectedDayInsight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@color/bg_light"
                            android:padding="12dp"
                            android:text="Tocá una categoría arriba o un día acá para ver el detalle."
                            android:textColor="@color/text_muted"
                            android:textSize="16sp" />

                        <!-- Toggle para desglose de 30 días -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleDetalleDiario"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:text="Ver desglose día por día ▾"
                            android:textColor="@color/bank_accent" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvMonthlyDayList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:overScrollMode="never"
                            android:nestedScrollingEnabled="false"
                            android:visibility="gone"
                            tools:listitem="@layout/item_prediction_day" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        android:background="@color/surface_white"
        app:itemTextAppearance="@style/Text.ModuloInteligente.Subtitle"
        app:itemIconTint="@color/bank_primary"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
