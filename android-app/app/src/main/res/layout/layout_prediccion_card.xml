<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"

    app:cardBackgroundColor="@color/card_surface"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Predicción de Gasto Hoy"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvPrediccionFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cargando..."
            android:textSize="16sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="4dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_surface_alt"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:contentPadding="16dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                
                <TextView
                    android:id="@+id/tvPrediccionMonto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bs. --"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                    
                <TextView
                    android:id="@+id/tvPrediccionNivel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/bank_accent"
                    android:background="@color/card_surface_alt"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvPrediccionDiferencia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textSize="16sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="16dp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvPrediccionSemaforo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/card_surface_alt"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="Alerta IA: —"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProbabilidadesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            tools:listitem="@layout/item_probabilidad_ia" />

        <Button
            android:id="@+id/btnCambiarFalsaFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Demo] Simular Día Siguiente"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/bank_accent"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
