<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ModuloInteligente" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/bank_primary</item>
        <item name="colorPrimaryVariant">@color/bank_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/bank_gold</item>
        <item name="colorSecondaryVariant">@color/bank_gold_dark</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>

        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bank_primary_dark</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <item name="materialButtonStyle">@style/Widget.ModuloInteligente.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.ModuloInteligente.TextInput</item>
        <item name="materialCardViewStyle">@style/Widget.ModuloInteligente.Card</item>
    </style>
</resources>
